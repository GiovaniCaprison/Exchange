#!/bin/sh
# Formats what is about to be committed, so the build's format check never fires on style.
#
# The first cmake configure installs this by pointing core.hooksPath at hooks/. To install by
# hand:
#
#   git config core.hooksPath hooks
#
# The whole file is formatted and restaged, so a partially staged file gets its unstaged hunks
# staged with it. Formatting on save keeps that from ever mattering.

staged() {
  git diff --cached --name-only --diff-filter=ACMR -- "$@"
}

cpp_files=$(staged '*.cpp' '*.hpp')
if [ -n "$cpp_files" ]; then
  # The pinned version first, fetched by pipx, so the hook and the workflow agree to the byte.
  pinned=$(cat "$(git rev-parse --show-toplevel)/.clang-format-version")
  if command -v pipx >/dev/null 2>&1; then
    printf '%s\n' "$cpp_files" | tr '\n' '\0' | xargs -0 pipx run "clang-format==${pinned}" -i || exit 1
    printf '%s\n' "$cpp_files" | tr '\n' '\0' | xargs -0 git add
  elif command -v clang-format >/dev/null 2>&1; then
    printf '%s\n' "$cpp_files" | tr '\n' '\0' | xargs -0 clang-format -i || exit 1
    printf '%s\n' "$cpp_files" | tr '\n' '\0' | xargs -0 git add
  else
    echo "pre-commit: no clang-format on this machine; the ci workflow checks instead" >&2
  fi
fi

exit 0
