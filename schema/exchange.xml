<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe" byteOrder="littleEndian" description="The exchange's sequenced commands and events" id="1" package="exchange.protocol" semanticVersion="1.1" version="1">
  <!--
    Every message that crosses a process boundary. docs/PROTOCOL.md is the contract this file
    implements: field orders, alignment, semantics and the refusal precedence all live there, and a
    change here is a change there first. Adding a field or a message is a version bump on this one
    schema; existing decoders keep working.
  -->
  <types>
    <composite name="messageHeader" description="Template and schema identification">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId" primitiveType="uint16"/>
      <type name="schemaId" primitiveType="uint16"/>
      <type name="version" primitiveType="uint16"/>
    </composite>
    <composite name="CommandContext" description="Written by the sequencer; opens every command">
      <!-- The command's place in the global order, assigned exactly once (P-1). -->
      <type name="sequence" primitiveType="uint64"/>
      <!-- Nanoseconds since the epoch, stamped at sequencing; the venue's one clock reading (P-3). -->
      <type name="timestamp" primitiveType="uint64"/>
      <type name="instrumentId" primitiveType="uint32"/>
      <!-- Alignment padding, always zero, so every 64 bit body field sits on an eight byte boundary. -->
      <type name="reserved" primitiveType="uint32"/>
    </composite>
    <composite name="PublicContext" description="Opens every public feed message; the feed's own numbering is carried by its ranges">
      <!-- The answered command's timestamp, carried unchanged, so the public feed is replayable. -->
      <type name="timestamp" primitiveType="uint64"/>
      <type name="instrumentId" primitiveType="uint32"/>
      <type name="reserved" primitiveType="uint32"/>
    </composite>
    <composite name="EventContext" description="Written by the matcher; opens every event">
      <!-- The event's place in this partition's event stream, gap free from 1. -->
      <type name="sequence" primitiveType="uint64"/>
      <!-- The sequence of the command this event answers: the attribution a private stream needs. -->
      <type name="inputSequence" primitiveType="uint64"/>
      <!-- The answered command's timestamp, carried unchanged (P-3), which keeps replay byte exact. -->
      <type name="timestamp" primitiveType="uint64"/>
      <type name="instrumentId" primitiveType="uint32"/>
      <type name="reserved" primitiveType="uint32"/>
    </composite>
    <enum name="Side" encodingType="uint8">
      <validValue name="BUY">0</validValue>
      <validValue name="SELL">1</validValue>
    </enum>
    <enum name="Pricing" encodingType="uint8">
      <validValue name="LIMIT">0</validValue>
      <validValue name="MARKET">1</validValue>
    </enum>
    <enum name="TimeInForce" encodingType="uint8">
      <validValue name="GOOD_TILL_CANCEL">0</validValue>
      <validValue name="DAY">1</validValue>
      <validValue name="IMMEDIATE_OR_CANCEL">2</validValue>
      <validValue name="FILL_OR_KILL">3</validValue>
    </enum>
    <set name="OrderFlags" encodingType="uint8">
      <choice name="postOnly">0</choice>
    </set>
    <enum name="RiskRefusal" encodingType="uint8">
      <validValue name="RATE_LIMIT">0</validValue>
      <validValue name="MAX_ORDER_SIZE">1</validValue>
      <validValue name="MAX_NOTIONAL">2</validValue>
      <validValue name="DUPLICATE">3</validValue>
      <validValue name="PRICE_COLLAR">4</validValue>
      <validValue name="CREDIT">5</validValue>
    </enum>
    <enum name="LoginRefusal" encodingType="uint8">
      <validValue name="BAD_CREDENTIAL">0</validValue>
      <validValue name="UNKNOWN_PARTICIPANT">1</validValue>
      <validValue name="ALREADY_LOGGED_IN">2</validValue>
      <validValue name="SEQUENCE_AHEAD">3</validValue>
      <!-- The kill switch's word: the participant is blocked at the venue's door. -->
      <validValue name="KILLED">4</validValue>
    </enum>
    <enum name="Allocation" encodingType="uint8">
      <validValue name="PRICE_TIME">0</validValue>
      <validValue name="PRO_RATA">1</validValue>
    </enum>
    <enum name="SessionState" encodingType="uint8">
      <validValue name="PRE_OPEN">0</validValue>
      <validValue name="OPENING_AUCTION">1</validValue>
      <validValue name="CONTINUOUS">2</validValue>
      <validValue name="CLOSING_AUCTION">3</validValue>
      <validValue name="HALTED">4</validValue>
      <validValue name="CLOSED">5</validValue>
    </enum>
    <enum name="RejectReason" encodingType="uint8">
      <validValue name="NON_POSITIVE_QUANTITY">0</validValue>
      <validValue name="LOT_VIOLATION">1</validValue>
      <validValue name="NON_POSITIVE_PRICE">2</validValue>
      <validValue name="TICK_VIOLATION">3</validValue>
      <validValue name="STATIC_BAND_VIOLATION">4</validValue>
      <validValue name="DYNAMIC_BAND_VIOLATION">5</validValue>
      <validValue name="INVALID_FIELDS">6</validValue>
      <validValue name="MINIMUM_QUANTITY_ABOVE_ORDER">7</validValue>
      <validValue name="DISPLAY_QUANTITY_ABOVE_ORDER">8</validValue>
      <validValue name="MINIMUM_QUANTITY_NOT_MET">9</validValue>
      <validValue name="WOULD_CROSS">10</validValue>
      <validValue name="FILL_OR_KILL_UNFILLABLE">11</validValue>
      <validValue name="STATE_NOT_PERMITTED">12</validValue>
      <validValue name="UNKNOWN_ORDER">13</validValue>
      <validValue name="QUANTITY_BELOW_EXECUTED">14</validValue>
    </enum>
    <enum name="AlertKind" encodingType="uint8">
      <validValue name="WASH_TRADE">0</validValue>
      <validValue name="SPOOFING">1</validValue>
      <validValue name="LAYERING">2</validValue>
    </enum>
    <enum name="RemoveReason" encodingType="uint8">
      <validValue name="CANCELLED">0</validValue>
      <validValue name="REPLACED">1</validValue>
      <validValue name="MASS_CANCELLED">2</validValue>
      <validValue name="IMMEDIATE_OR_CANCEL_REMAINDER">3</validValue>
      <validValue name="SELF_MATCH_PREVENTED">4</validValue>
      <!-- A DAY order at the close: the session it lived in is over. -->
      <validValue name="EXPIRED">5</validValue>
    </enum>
  </types>

  <sbe:message name="InstrumentDefinition" id="1" description="Configures its instrument; precedes every other command for it">
    <field name="context" id="1" type="CommandContext"/>
    <field name="tickSize" id="2" type="int64"/>
    <field name="lotSize" id="3" type="int64"/>
    <field name="minPrice" id="4" type="int64"/>
    <field name="maxPrice" id="5" type="int64"/>
    <!-- Half width of the dynamic band, either side of the reference price. -->
    <field name="bandWidth" id="6" type="int64"/>
    <!-- The dynamic band's reference until the session's first execution. -->
    <field name="openingReference" id="7" type="int64"/>
    <!-- Implied decimal places in every price on this instrument (P-11). -->
    <field name="priceScale" id="8" type="uint8"/>
    <field name="allocation" id="9" type="Allocation"/>
  </sbe:message>

  <sbe:message name="NewOrder" id="2" description="Place an order">
    <field name="context" id="1" type="CommandContext"/>
    <field name="clientOrderId" id="2" type="uint64"/>
    <!-- Scaled integer. Ignored when pricing is MARKET. -->
    <field name="price" id="3" type="int64"/>
    <field name="quantity" id="4" type="int64"/>
    <!-- The four qualifiers below are absent when zero. -->
    <field name="minQuantity" id="5" type="int64"/>
    <!-- Below quantity makes the order an iceberg. -->
    <field name="displayQuantity" id="6" type="int64"/>
    <!-- Non-zero makes the order a stop, of whichever pricing it carries. -->
    <field name="triggerPrice" id="7" type="int64"/>
    <!-- Prevention applies between orders sharing a non-zero value. -->
    <field name="smpId" id="8" type="uint64"/>
    <field name="participantId" id="9" type="uint32"/>
    <field name="side" id="10" type="Side"/>
    <field name="pricing" id="11" type="Pricing"/>
    <field name="timeInForce" id="12" type="TimeInForce"/>
    <field name="flags" id="13" type="OrderFlags"/>
  </sbe:message>

  <!--
    An amendment names its order by the id the client gave it. A client can only know the engine's
    id once it has been told, so naming its own id means a cancel can be sent the moment it is
    decided, and a recorded command stream replays without knowing what any engine did with it.
  -->
  <sbe:message name="CancelOrder" id="3" description="Cancel a resting order or a waiting stop">
    <field name="context" id="1" type="CommandContext"/>
    <field name="clientOrderId" id="2" type="uint64"/>
    <field name="participantId" id="3" type="uint32"/>
  </sbe:message>

  <sbe:message name="ReplaceOrder" id="4" description="Replace a resting order, carrying full intent">
    <field name="context" id="1" type="CommandContext"/>
    <field name="clientOrderId" id="2" type="uint64"/>
    <field name="quantity" id="3" type="int64"/>
    <field name="price" id="4" type="int64"/>
    <field name="participantId" id="5" type="uint32"/>
  </sbe:message>

  <sbe:message name="MassCancel" id="5" description="Remove everything one participant has resting or waiting">
    <field name="context" id="1" type="CommandContext"/>
    <field name="clientOrderId" id="2" type="uint64"/>
    <field name="participantId" id="3" type="uint32"/>
  </sbe:message>

  <sbe:message name="SessionControl" id="6" description="Enter a trading state">
    <field name="context" id="1" type="CommandContext"/>
    <field name="state" id="2" type="SessionState"/>
  </sbe:message>

  <sbe:message name="CommandSequenced" id="20" description="The sequencer's acknowledgment to a gateway: the submission is durable and holds this place in the order">
    <field name="gatewaySequence" id="1" type="uint64"/>
    <field name="sequence" id="2" type="uint64"/>
    <field name="timestamp" id="3" type="uint64"/>
  </sbe:message>

  <sbe:message name="ReplicationAck" id="21" description="The standby has the stream up to this sequence at this epoch">
    <field name="upToSequence" id="1" type="uint64"/>
    <field name="epoch" id="2" type="uint32"/>
    <field name="reserved" id="3" type="uint32"/>
  </sbe:message>

  <sbe:message name="LeaseRequest" id="22" description="A node asks the witness to hold or take the sequencing lease">
    <field name="lastSequence" id="1" type="uint64"/>
    <field name="nodeId" id="2" type="uint32"/>
    <!-- The current epoch to renew, or a higher one to take over. -->
    <field name="epoch" id="3" type="uint32"/>
  </sbe:message>

  <sbe:message name="LeaseResponse" id="23" description="The witness's answer: who holds which epoch, for how long">
    <field name="ttl" id="1" type="uint64"/>
    <field name="epoch" id="2" type="uint32"/>
    <field name="holder" id="3" type="uint32"/>
    <field name="granted" id="4" type="uint8"/>
  </sbe:message>

  <sbe:message name="RewindRequest" id="24" description="A consumer asks the rewinder for a range of the sequenced stream">
    <field name="firstSequence" id="1" type="uint64"/>
    <field name="count" id="2" type="uint32"/>
    <field name="reserved" id="3" type="uint32"/>
  </sbe:message>

  <sbe:message name="GatewaySubmission" id="25" description="Prefixes a framed command on the gateway to sequencer carrier">
    <!-- The gateway's own numbering of what it submits; the sequencer deduplicates on the pair. -->
    <field name="gatewaySequence" id="1" type="uint64"/>
    <field name="gatewayId" id="2" type="uint32"/>
    <field name="reserved" id="3" type="uint32"/>
  </sbe:message>

  <sbe:message name="RangeHeader" id="26" description="Opens a range of the sequenced stream, on the publication and replication carriers alike">
    <field name="firstSequence" id="1" type="uint64"/>
    <!-- The leadership epoch the range was published under; consumers reject stale epochs. -->
    <field name="epoch" id="2" type="uint32"/>
    <!-- Messages in the range. Zero is a heartbeat; 65535 is end of session. -->
    <field name="count" id="3" type="uint16"/>
    <field name="reserved" id="4" type="uint16"/>
  </sbe:message>

  <sbe:message name="OrderAccepted" id="10" description="Admitted, with its engine order id">
    <field name="context" id="1" type="EventContext"/>
    <field name="orderId" id="2" type="uint64"/>
    <field name="clientOrderId" id="3" type="uint64"/>
    <field name="participantId" id="4" type="uint32"/>
  </sbe:message>

  <sbe:message name="OrderRejected" id="11" description="Refused, and no state changed">
    <field name="context" id="1" type="EventContext"/>
    <field name="clientOrderId" id="2" type="uint64"/>
    <field name="participantId" id="3" type="uint32"/>
    <field name="reason" id="4" type="RejectReason"/>
  </sbe:message>

  <sbe:message name="OrderRested" id="12" description="Entered the book; quantity is displayed quantity only">
    <field name="context" id="1" type="EventContext"/>
    <field name="orderId" id="2" type="uint64"/>
    <field name="price" id="3" type="int64"/>
    <field name="quantity" id="4" type="int64"/>
    <field name="side" id="5" type="Side"/>
  </sbe:message>

  <sbe:message name="OrderExecuted" id="13" description="One execution, at the resting order's price">
    <field name="context" id="1" type="EventContext"/>
    <field name="executionId" id="2" type="uint64"/>
    <field name="aggressorOrderId" id="3" type="uint64"/>
    <field name="restingOrderId" id="4" type="uint64"/>
    <field name="price" id="5" type="int64"/>
    <field name="quantity" id="6" type="int64"/>
  </sbe:message>

  <sbe:message name="OrderReduced" id="14" description="New displayed quantity, queue position kept">
    <field name="context" id="1" type="EventContext"/>
    <field name="orderId" id="2" type="uint64"/>
    <field name="quantity" id="3" type="int64"/>
  </sbe:message>

  <sbe:message name="OrderRemoved" id="15" description="Left the book, with the quantity removed">
    <field name="context" id="1" type="EventContext"/>
    <field name="orderId" id="2" type="uint64"/>
    <field name="quantity" id="3" type="int64"/>
    <field name="reason" id="4" type="RemoveReason"/>
  </sbe:message>

  <sbe:message name="OrderTriggered" id="16" description="A stop's condition was met and it left the trigger book">
    <field name="context" id="1" type="EventContext"/>
    <field name="orderId" id="2" type="uint64"/>
  </sbe:message>

  <sbe:message name="SessionStateChanged" id="17" description="The state now in effect">
    <field name="context" id="1" type="EventContext"/>
    <field name="state" id="2" type="SessionState"/>
  </sbe:message>

  <sbe:message name="LoginRequest" id="30" description="Opens a session: who the client is, and the session sequence it expects next">
    <!-- One past the last sequenced message the client saw; zero on a first connection. -->
    <field name="expectedSequence" id="1" type="uint64"/>
    <field name="credential" id="2" type="uint64"/>
    <field name="participantId" id="3" type="uint32"/>
    <field name="reserved" id="4" type="uint32"/>
  </sbe:message>

  <sbe:message name="LoginAccepted" id="31" description="The session is open; replay begins at the sequence the client asked for">
    <field name="nextSequence" id="1" type="uint64"/>
    <field name="participantId" id="2" type="uint32"/>
    <field name="reserved" id="3" type="uint32"/>
  </sbe:message>

  <sbe:message name="LoginRejected" id="32" description="The session did not open, and the connection will close">
    <field name="reason" id="1" type="LoginRefusal"/>
  </sbe:message>

  <sbe:message name="SessionHeartbeat" id="33" description="Either side's pulse; silence past the interval is a dead peer">
    <field name="reserved" id="1" type="uint64"/>
  </sbe:message>

  <sbe:message name="LogoutRequest" id="34" description="The client asks to end the session cleanly">
    <field name="reserved" id="1" type="uint64"/>
  </sbe:message>

  <sbe:message name="SessionEnded" id="35" description="The gateway's last word on a session, clean or not">
    <field name="reserved" id="1" type="uint64"/>
  </sbe:message>

  <sbe:message name="CommandRefused" id="36" description="The gate's answer when risk says no: the command never reached the venue">
    <field name="clientOrderId" id="1" type="uint64"/>
    <field name="reason" id="2" type="RiskRefusal"/>
  </sbe:message>

  <sbe:message name="AuctionIndicative" id="18" description="Uncrossing price and volume if the auction ran now">
    <field name="context" id="1" type="EventContext"/>
    <field name="price" id="2" type="int64"/>
    <field name="quantity" id="3" type="int64"/>
  </sbe:message>

  <sbe:message name="PublicOrderAdded" id="40" description="A displayed order entered the book; no message here can say whose">
    <field name="context" id="1" type="PublicContext"/>
    <field name="orderId" id="2" type="uint64"/>
    <field name="price" id="3" type="int64"/>
    <field name="quantity" id="4" type="int64"/>
    <field name="side" id="5" type="Side"/>
  </sbe:message>

  <sbe:message name="PublicOrderExecuted" id="41" description="A book order traded this quantity at this price">
    <field name="context" id="1" type="PublicContext"/>
    <field name="orderId" id="2" type="uint64"/>
    <field name="executionId" id="3" type="uint64"/>
    <field name="price" id="4" type="int64"/>
    <field name="quantity" id="5" type="int64"/>
  </sbe:message>

  <sbe:message name="PublicOrderReduced" id="42" description="A book order's displayed quantity is now this">
    <field name="context" id="1" type="PublicContext"/>
    <field name="orderId" id="2" type="uint64"/>
    <field name="quantity" id="3" type="int64"/>
  </sbe:message>

  <sbe:message name="PublicOrderRemoved" id="43" description="A book order left the book">
    <field name="context" id="1" type="PublicContext"/>
    <field name="orderId" id="2" type="uint64"/>
  </sbe:message>

  <sbe:message name="PublicSessionState" id="44" description="The trading state now in effect">
    <field name="context" id="1" type="PublicContext"/>
    <field name="state" id="2" type="SessionState"/>
  </sbe:message>

  <sbe:message name="PublicAuctionIndicative" id="45" description="Uncrossing price and volume if the auction ran now">
    <field name="context" id="1" type="PublicContext"/>
    <field name="price" id="2" type="int64"/>
    <field name="quantity" id="3" type="int64"/>
  </sbe:message>

  <sbe:message name="PublicTopOfBook" id="46" description="The touch, conflated: best bid and offer with their displayed depth">
    <field name="context" id="1" type="PublicContext"/>
    <field name="bidPrice" id="2" type="int64"/>
    <field name="bidQuantity" id="3" type="int64"/>
    <field name="askPrice" id="4" type="int64"/>
    <field name="askQuantity" id="5" type="int64"/>
  </sbe:message>

  <sbe:message name="SnapshotComplete" id="47" description="The snapshot's last word: join the live feed at this sequence">
    <field name="nextSequence" id="1" type="uint64"/>
    <field name="instruments" id="2" type="uint32"/>
    <field name="reserved" id="3" type="uint32"/>
  </sbe:message>

  <sbe:message name="PublicSessionSummary" id="48" description="The session's last word on its instrument: the official numbers of the day">
    <field name="context" id="1" type="PublicContext"/>
    <field name="openPrice" id="2" type="int64"/>
    <field name="highPrice" id="3" type="int64"/>
    <field name="lowPrice" id="4" type="int64"/>
    <!-- The last print of the session, the closing cross when one ran: the official close. -->
    <field name="closePrice" id="5" type="int64"/>
    <field name="volume" id="6" type="int64"/>
    <field name="prints" id="7" type="uint64"/>
  </sbe:message>

  <sbe:message name="SurveillanceAlert" id="50" description="A detection over the stream; the sequence range is the case file">
    <field name="alertId" id="1" type="uint64"/>
    <!-- The sequence and carried timestamp of the event that completed the pattern. -->
    <field name="sequence" id="2" type="uint64"/>
    <field name="timestamp" id="3" type="uint64"/>
    <field name="executedQuantity" id="4" type="int64"/>
    <field name="cancelledQuantity" id="5" type="int64"/>
    <field name="participantId" id="6" type="uint32"/>
    <field name="instrumentId" id="7" type="uint32"/>
    <!-- Distinct cancelled price levels inside the window; two or more reads as layering. -->
    <field name="priceLevels" id="8" type="uint32"/>
    <field name="kind" id="9" type="AlertKind"/>
  </sbe:message>

</sbe:messageSchema>
